# Copy to .env for local development. In the homelab, Ansible injects these.
# Nothing here has a secret as a default — the service refuses to start without
# DEVICE_TOKEN and DARWIN_ACCESS_TOKEN.

# Shared bearer the Device presents. Also accepted as ?token= so you can open
# /preview in a browser.
DEVICE_TOKEN=change-me

# Darwin OpenLDBWS token, passed through to Huxley2.
# Note: National Rail retired self-service token issuing in early 2026 — a
# replacement means registering at raildata.org.uk. Do not lose this one.
DARWIN_ACCESS_TOKEN=change-me

# The public Huxley2 instance has no uptime guarantee. Point this at a
# self-hosted one when that starts to bite.
HUXLEY_BASE_URL=https://huxley2.azurewebsites.net

STATION_ORIGIN=KEL
STATION_DESTINATION=LST

# Ten minutes to walk to Kelvedon, plus slack. A departure sooner than this is
# not information, it is clutter.
DEPARTURE_MIN_LEAD_MINUTES=15

TZ=Europe/London

# Port inside the container. Leave it alone unless you have a reason.
PORT=8080

# Port published on the host. This is the one the device's FRAME_URL must use.
DISPLAY_HOST_PORT=8080
